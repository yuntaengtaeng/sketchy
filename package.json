{
  "name": "sketchy",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "mcp": "tsx src/mcp/server.ts",
    "test:mcp": "node --experimental-strip-types --test tests/canvas-name.test.ts tests/mcp-read.test.ts tests/mcpb-manifest.test.ts tests/project-export.test.ts tests/project-import.test.ts tests/project-migration.test.ts tests/validate-feature-action.test.ts",
    "build:mcpb": "vite build --config vite.mcpb.config.ts && node scripts/build-mcpb.mjs",
    "build": "tsc --noEmit && vite build && vite build --config vite.plugin.config.ts && npm run build:mcpb",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@figma/plugin-typings": "latest",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "prettier": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-singlefile": "latest",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "fflate": "^0.8.3",
    "tsx": "^4.23.13"
  }
}
